# The agent's brain is the Claude Code CLI itself, invoked headlessly
# (`claude -p`) with cwd = the vault. It authenticates via your existing
# Claude Code login (subscription), not a separate API key — nothing to
# set here for that. Research uses Claude Code's built-in WebSearch/WebFetch
# tools, so no separate search API key is needed either.

# Google Cloud TTS/STT (simple API key, same pattern as voice-buddy-app)
GOOGLE_TTS_KEY=
GOOGLE_STT_KEY=

# Auth — generate with `npm run hash-password`
AUTH_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# Web Push — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rebawntech@gmail.com

# Optional overrides
PORT=3000
VAULT_PATH=vault
CHECKIN_CRON=0 8,13,18 * * *
